<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel"
    modelName="Ops" runtimePlatform="RCP" featureDelegation="Reflective">
  <foreignModel>ops.ecore</foreignModel>
  <genPackages prefix="Ops" ecorePackage="ops.ecore#/">
    <genClasses ecoreClass="ops.ecore#//Shape">
      <genFeatures ecoreFeature="ecore:EAttribute ops.ecore#//Shape/label"/>
      <genFeatures ecoreFeature="ecore:EAttribute ops.ecore#//Shape/size"/>
      <genOperations ecoreOperation="ops.ecore#//Shape/scale">
        <genParameters ecoreParameter="ops.ecore#//Shape/scale/factor"/>
        <genParameters ecoreParameter="ops.ecore#//Shape/scale/steps"/>
      </genOperations>
      <genOperations ecoreOperation="ops.ecore#//Shape/ping"/>
      <genOperations ecoreOperation="ops.ecore#//Shape/ping.1"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>

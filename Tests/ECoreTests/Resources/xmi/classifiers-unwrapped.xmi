<?xml version="1.0" encoding="UTF-8"?>
<cls:Package xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:cls="http://example.org/classifiers"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="library">
  <classifiers xsi:type="cls:DataType" name="Integer"/>
  <classifiers xsi:type="cls:DataType" name="String"/>
  <classifiers xsi:type="cls:Class" name="Author">
    <attributes name="surname" type="//@classifiers.1"/>
  </classifiers>
  <classifiers xsi:type="cls:Class" name="Book" isAbstract="true" rank="3">
    <attributes name="title" type="//@classifiers.1"/>
    <attributes name="pages" type="//@classifiers.0"/>
    <attributes name="authors" multiValued="true" type="//@classifiers.2"/>
  </classifiers>
</cls:Package>

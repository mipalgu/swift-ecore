      <details key="depth" value="1"/>
    </eAnnotations>
    <eAnnotations source="urn:example:contents">
      <contents xsi:type="ecore:EClass" name="Embedded"/>
    </eAnnotations>
    <eOperations name="borrow">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Borrows the book."/>
        <details key="body" value="return days > 0;"/>
      </eAnnotations>
      <eParameters name="days" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="The number of days."/>
        </eAnnotations>
      </eParameters>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">

module Arith

context-free sorts Expr Op
lexical sorts ID INT

lexical syntax
  ID  = [a-zA-Z] [a-zA-Z0-9]*
  INT = [0-9]+

context-free syntax
  Expr.Num   = <<value:INT>>
  Expr.Var   = <<name:ID>>
  Expr.BinOp = <(<left:Expr> <operator:Op> <right:Expr>)>
  Expr.Let   = <let <name:ID> = <init:Expr> in <body:Expr>>
  Op.Add = <+>
  Op.Sub = <->
  Op.Mul = <*>
  Op.Div = </>
